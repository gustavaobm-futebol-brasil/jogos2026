---
import Base from '../layouts/Base.astro';
import { DESTAQUES } from '../config.js';
import { jogoLinkado } from '../scripts/escudos.js';
import { urlComp } from '../scripts/slug.js';
import { destaquesDaRodada } from '../lib/destaques.js';
import { escudoHtml, jogos, realizados, meta, porCompeticao, soma, fmtInt, fmtBRL, fmtBRLcompacto, fmtData } from '../lib/dados.js';

const comPub = realizados.filter((j) => j.pub != null);
const comBordero = realizados.filter((j) => j.temB);
const comRenda = realizados.filter((j) => j.bruta != null);
const federacoes = new Set(jogos.map((j) => j.fonte)).size;

const maiores = [...comPub].sort((a, b) => b.pub - a.pub).slice(0, 10);
const maxPub = maiores[0]?.pub || 1;

const comps = porCompeticao().filter((c) => c.nPub >= 10).sort((a, b) => b.pubMedio - a.pubMedio).slice(0, 12);
const maxMedio = comps[0]?.pubMedio || 1;

const maioresRendas = [...comRenda].sort((a, b) => b.bruta - a.bruta).slice(0, 8);
const maxBruta = maioresRendas[0]?.bruta || 1;
const dr = DESTAQUES ? destaquesDaRodada() : null;
const razaoTxt = (r) => (r >= 1 ? `${r.toFixed(1).replace('.', ',')}× a média` : `${Math.round(100 * r)}% da média`);
const clsJogos = escudoHtml('Flamengo') ? 'barras com-jogos' : 'barras';   // com escudos, a coluna do jogo é mais larga
---
<Base titulo="" descricao="Quanto público e quanto dinheiro os jogos do futebol brasileiro movimentaram em 2026, a partir dos borderôs publicados pelas federações.">
  <h1>Quanto o futebol brasileiro arrecada em 2026?</h1>
  <p class="lead">
    Público, arrecadação e despesas de cada jogo, lidos dos borderôs e súmulas que as federações publicam. Cada número aponta para o documento original.
  </p>

  <div class="kpis">
    <div class="kpi"><div class="v">{fmtInt(realizados.length)}</div><div class="l">jogos já disputados, de {federacoes} fontes (CBF e federações estaduais)</div></div>
    <div class="kpi"><div class="v">{fmtInt(soma(comPub.map((j) => j.pub)))}</div><div class="l">pessoas nos estádios em {fmtInt(comPub.length)} jogos com público registrado</div></div>
    <div class="kpi"><div class="v">{fmtBRLcompacto(soma(comRenda.map((j) => j.bruta)))}</div><div class="l">de arrecadação bruta em bilheteria, em {fmtInt(comRenda.length)} borderôs</div></div>
    <div class="kpi"><div class="v">{fmtInt(comBordero.length)}</div><div class="l">borderôs lidos ({Math.round((100 * comBordero.length) / realizados.length)}% dos jogos disputados)</div></div>
  </div>
  <p class="small muted">Nem toda federação publica o borderô de todos os jogos; onde ele não existe, o jogo aparece sem público e sem valores. Veja a <a href="/metodologia">metodologia</a>.</p>

  {dr && dr.nJogos > 0 && (
    <section class="rodada">
      <h2>Na última rodada</h2>
      <p class="periodo">{dr.janela.nome}, {dr.janela.periodo} · {fmtInt(dr.nComPub)} de {fmtInt(dr.nJogos)} jogos com público registrado até agora (os borderôs chegam com atraso, então estes números podem mudar).</p>
      <div class="grade">
        {[['Série A do Brasileiro', dr.serieA], ['Séries B, C e D do Brasileiro', dr.inferiores], ['Estaduais e copas estaduais', dr.estaduais]].map(([titulo, e]) => (
          <div class="bloco">
            <h3>{titulo}</h3>
            {e.n === 0 ? <p class="vazio">Nenhum jogo com público registrado nesta janela.</p> : [[e.n === 1 ? 'Único' : 'Maior', e.maior], ['Menor', e.menor]].filter(([, j]) => j).map(([rot, j]) => (
              <div class="lin">
                <span class="rot">{rot}</span>
                <span class="jogo"><Fragment set:html={jogoLinkado(j.mandante, j.visitante)} /><small><a class="tl" href={urlComp(j.comp)}>{j.comp}</a> · {fmtData(j.data)}</small></span>
                <span class="val">{fmtInt(j.pub)}</span>
              </div>
            ))}
            {e.n === 1 && <p class="vazio">Só um jogo deste grupo com público registrado na janela, então não há maior e menor.</p>}
          </div>
        ))}
        <div class="bloco">
          <h3>Mais fora do normal</h3>
          {!dr.acima && !dr.abaixo ? <p class="vazio">Nenhum jogo da janela foge muito da média do mandante.</p> : [['Acima', dr.acima], ['Abaixo', dr.abaixo]].filter(([, c]) => c).map(([rot, c]) => (
            <div class="lin">
              <span class="rot">{rot}</span>
              <span class="jogo"><Fragment set:html={jogoLinkado(c.jogo.mandante, c.jogo.visitante)} /><small><a class="tl" href={urlComp(c.jogo.comp)}>{c.jogo.comp}</a> · {fmtData(c.jogo.data)}</small><small>{fmtInt(c.jogo.pub)} pessoas; média do {c.jogo.mandante} em casa: {fmtInt(c.media)}</small></span>
              <span class="val">{razaoTxt(c.razao)}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="small muted">Rodada aproximada por data: fim de semana (sexta a segunda) ou meio de semana (terça a quinta). O “fora do normal” compara o público com a média do mandante nos outros jogos em casa (clubes com ao menos {5} jogos com público). O menor público ignora jogos com público 0.</p>
    </section>
  )}

  <div class="duas">
    <section>
      <h2>Maiores públicos</h2>
      <ol class={clsJogos}>
        {maiores.map((j) => (
          <li>
            <span class="nome"><Fragment set:html={jogoLinkado(j.mandante, j.visitante)} /><small><a class="tl" href={urlComp(j.comp)}>{j.comp}</a> · {fmtData(j.data)}</small></span>
            <span class="trilho"><i style={`width:${(100 * j.pub) / maxPub}%`}></i></span>
            <span class="valor">{fmtInt(j.pub)}</span>
          </li>
        ))}
      </ol>
    </section>
    <section>
      <h2>Público médio por competição</h2>
      <ol class="barras">
        {comps.map((c) => (
          <li>
            <span class="nome"><a class="tl" href={urlComp(c.comp)}>{c.comp}</a><small>{c.uf} · {fmtInt(c.nPub)} jogos</small></span>
            <span class="trilho"><i style={`width:${(100 * c.pubMedio) / maxMedio}%`}></i></span>
            <span class="valor">{fmtInt(c.pubMedio)}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <section>
    <h2>Maiores arrecadações em um jogo</h2>
    <ol class={clsJogos}>
      {maioresRendas.map((j) => (
        <li>
          <span class="nome"><Fragment set:html={jogoLinkado(j.mandante, j.visitante)} /><small><a class="tl" href={urlComp(j.comp)}>{j.comp}</a> · {fmtData(j.data)} · público {fmtInt(j.pub)}</small></span>
          <span class="trilho"><i style={`width:${(100 * j.bruta) / maxBruta}%`}></i></span>
          <span class="valor">{fmtBRLcompacto(j.bruta)}</span>
        </li>
      ))}
    </ol>
  </section>

  <div class="nota">
    Quer ver os números de um jogo, um clube ou uma competição? Use o <a href="/jogos">explorador de jogos</a>, o <a href="/clubes">ranking de clubes</a> ou a lista de <a href="/competicoes">competições</a>.
  </div>
</Base>
