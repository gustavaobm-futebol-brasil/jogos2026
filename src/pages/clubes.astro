---
import Base from '../layouts/Base.astro';
import { nomeComEscudo, porClube, fmtInt, fmtBRL, fmtData } from '../lib/dados.js';

// Versão inicial (todas as competições), renderizada no build; o navegador a refaz a partir de /dados/clubes.json
// quando se escolhe uma competição ou se ordena.
const MINIMO = 3;
const clubes = porClube(MINIMO).sort((a, b) => b.pubMedio - a.pubMedio);
---
<Base titulo="Clubes" descricao="Ranking de público médio dos clubes jogando em casa.">
  <h1>Clubes: público em casa</h1>
  <p class="lead" id="lead">Público médio de cada clube como mandante em 2026. Entram clubes com pelo menos {MINIMO} jogos em casa com público registrado.</p>

  <div class="filtros" id="filtros-clubes">
    <label>Clube ou estado<input type="search" id="busca-clube" placeholder="ex.: Cruzeiro, MG" autocomplete="off" /></label>
    <label>Competição<select id="f-comp-clube"><option value="">Todas</option></select></label>
    <label>Estado<select id="f-uf-clube"><option value="">Todos</option></select></label>
  </div>
  <div class="filtros" id="opcoes-clubes">
    <label class="marcar" id="lbl-todos-jogos" hidden><input type="checkbox" id="f-todos-jogos" /> Incluir os jogos dos clubes em todas as competições (não só nesta)</label>
    <span class="muted small">Ocultar clubes que jogaram o Brasileiro:</span>
    <label class="marcar"><input type="checkbox" class="f-sem-serie" value="A" /> Série A</label>
    <label class="marcar"><input type="checkbox" class="f-sem-serie" value="B" /> Série B</label>
    <label class="marcar"><input type="checkbox" class="f-sem-serie" value="C" /> Série C</label>
    <label class="marcar"><input type="checkbox" class="f-sem-serie" value="D" /> Série D</label>
  </div>
  <p class="nota" id="nota-comp" hidden></p>
  <p class="muted small" id="contagem-clubes" role="status">{clubes.length} clubes</p>

  <div class="tabela">
    <table id="tab-clubes">
      <thead>
        <tr>
          <th data-ord="nome">Clube</th>
          <th data-ord="uf">UF</th>
          <th class="n" data-ord="n">Jogos em casa</th>
          <th class="n desc" data-ord="pubMedio">Público médio</th>
          <th class="n" data-ord="maior">Maior público</th>
          <th class="n" data-ord="rendaMedia">Renda líquida média</th>
        </tr>
      </thead>
      <tbody id="corpo-clubes">
        {clubes.map((c) => (
          <tr>
            <td><a class="time" href={`/jogos?time=${encodeURIComponent(c.clube)}`} title="Ver todos os jogos deste time" set:html={nomeComEscudo(c.clube)} /></td>
            <td>{c.uf}</td>
            <td class="n"><a href={`/jogos?time=${encodeURIComponent(c.clube)}&papel=mandante`} title="Ver os jogos em que o time foi mandante">{fmtInt(c.n)}</a></td>
            <td class="n">{fmtInt(c.pubMedio)}</td>
            <td class="n">{fmtInt(c.maior)}<small>contra {c.maiorContra}, {fmtData(c.maiorData)}</small></td>
            <td class="n">{c.rendaMedia == null ? '—' : fmtBRL(c.rendaMedia)}<small>{c.nRenda} borderô{c.nRenda === 1 ? '' : 's'}</small></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="legenda">Clique no nome do clube para ver todos os jogos dele, ou no número de jogos em casa para ver só os jogos como mandante. A renda líquida só considera os jogos com borderô lido. Valores negativos significam que as despesas do jogo superaram a bilheteria.</p>

  <script>
    import { definirEscudos, nomeComEscudo } from '../scripts/escudos.js';
    const MINIMO_GERAL = 3;
    const fmtInt = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 });
    const fmtBRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const semAcento = (s) => String(s ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const fmtData = (iso) => (iso ? iso.split('-').reverse().join('/') : '');

    let dados = null;          // resposta de /dados/clubes.json
    let participantes = [];    // por competição: Set dos índices de clube que a disputam (mandante ou visitante)
    let doBrasileiro = {};     // série -> Set dos clubes que a jogaram
    let ordem = { campo: 'pubMedio', dir: -1 };

    /** Soma as linhas do clube nas competições escolhidas (todas, ou só a selecionada). */
    function agregar(comp, todosJogos) {
      const iComp = comp ? dados.comps.indexOf(comp) : -1;
      // "todosJogos": os mesmos clubes que disputam a competição, mas somando os jogos em casa de TODAS as competições
      const doGrupo = comp && todosJogos ? participantes[iComp] : null;
      const porClube = new Map();
      for (const [ic, icomp, n, pubTotal, maior, contra, dataMaior, rendaTotal, nRenda] of dados.linhas) {
        if (doGrupo) { if (!doGrupo.has(ic)) continue; }
        else if (iComp >= 0 && icomp !== iComp) continue;
        const a = porClube.get(ic) || { n: 0, pubTotal: 0, maior: -1, contra: '', dataMaior: '', rendaTotal: 0, nRenda: 0 };
        a.n += n; a.pubTotal += pubTotal; a.rendaTotal += rendaTotal; a.nRenda += nRenda;
        if (maior > a.maior) { a.maior = maior; a.contra = contra; a.dataMaior = dataMaior; }
        porClube.set(ic, a);
      }
      // com uma competição escolhida, basta 1 jogo em casa com público (numa copa, muitos clubes jogam 1 ou 2 vezes em casa)
      const minimo = comp ? 1 : MINIMO_GERAL;
      return [...porClube.entries()].filter(([, a]) => a.n >= minimo).map(([ic, a]) => ({
        nome: dados.clubes[ic][0], uf: dados.clubes[ic][1], n: a.n, pubMedio: a.pubTotal / a.n, maior: a.maior, contra: a.contra, dataMaior: a.dataMaior,
        rendaMedia: a.nRenda ? a.rendaTotal / a.nRenda : null, nRenda: a.nRenda, ic,
      }));
    }

    function desenhar() {
      const comp = $('f-comp-clube').value;
      const todos = !!comp && $('f-todos-jogos').checked;
      const uf = $('f-uf-clube').value;
      const semSeries = [...document.querySelectorAll('.f-sem-serie:checked')].map((i) => i.value);
      $('lbl-todos-jogos').hidden = !comp;
      const q = semAcento($('busca-clube').value.trim());
      const { campo, dir } = ordem;
      const linhas = agregar(comp, todos).filter((c) => (!q || semAcento(c.nome).includes(q) || semAcento(c.uf).includes(q))
        && (!uf || c.uf === uf) && !semSeries.some((s) => doBrasileiro[s]?.has(c.ic))).sort((a, b) => {
        const x = campo === 'nome' || campo === 'uf' ? semAcento(a[campo]) : a[campo], y = campo === 'nome' || campo === 'uf' ? semAcento(b[campo]) : b[campo];
        if (x == null && y == null) return 0;
        if (x == null) return 1;
        if (y == null) return -1;
        return (x < y ? -1 : x > y ? 1 : 0) * dir;
      });
      const extra = comp && !todos ? `&comp=${encodeURIComponent(comp)}` : '';
      $('corpo-clubes').innerHTML = linhas.map((c) => `<tr>
        <td><a class="time" href="/jogos?time=${encodeURIComponent(c.nome)}${extra}" title="Ver os jogos deste time${comp && !todos ? ' nesta competição' : ''}">${nomeComEscudo(c.nome)}</a></td>
        <td>${esc(c.uf)}</td>
        <td class="n"><a href="/jogos?time=${encodeURIComponent(c.nome)}&papel=mandante${extra}" title="Ver os jogos em que o time foi mandante">${fmtInt.format(c.n)}</a></td>
        <td class="n">${fmtInt.format(c.pubMedio)}</td>
        <td class="n">${fmtInt.format(c.maior)}<small>contra ${esc(c.contra)}, ${fmtData(c.dataMaior)}</small></td>
        <td class="n">${c.rendaMedia == null ? '—' : fmtBRL.format(c.rendaMedia)}<small>${c.nRenda} borderô${c.nRenda === 1 ? '' : 's'}</small></td></tr>`).join('')
        || '<tr><td colspan="6" class="muted">Nenhum clube com esses filtros.</td></tr>';
      $('contagem-clubes').textContent = `${fmtInt.format(linhas.length)} clube${linhas.length === 1 ? '' : 's'}`;
      const nota = $('nota-comp');
      nota.hidden = !comp;
      if (comp) nota.textContent = todos
        ? `Os clubes que disputam “${comp}”, com os números de todos os jogos deles em casa, em qualquer competição (não só nesta). Entram clubes com pelo menos 1 jogo em casa com público registrado.`
        : `Só os clubes que jogaram em casa em “${comp}”, com os números dessa competição. Entram clubes com pelo menos 1 jogo em casa com público registrado.`;
      $('lead').hidden = !!comp;
      document.querySelectorAll('th[data-ord]').forEach((th) => {
        th.classList.toggle('asc', th.dataset.ord === campo && dir === 1);
        th.classList.toggle('desc', th.dataset.ord === campo && dir === -1);
      });
      const p = new URLSearchParams();
      if (comp) p.set('comp', comp);
      if (todos) p.set('todos', '1');
      if (uf) p.set('uf', uf);
      if (semSeries.length) p.set('sem', semSeries.join(''));
      if ($('busca-clube').value.trim()) p.set('q', $('busca-clube').value.trim());
      history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : ''));
    }

    /** Opções do filtro de competição: as que têm algum clube com jogo em casa com público, com o número de clubes. Com um estado
     *  escolhido, só as competições em que clubes DESSE estado jogaram em casa, contando só os clubes do estado. Mantém a
     *  competição selecionada se ela ainda existir; senão volta para "Todas". */
    function montarCompeticoes(atual) {
      const uf = $('f-uf-clube').value;
      const clubes = new Map();            // índice da competição -> clubes (índices) com jogo em casa nela
      for (const l of dados.linhas) {
        if (uf && dados.clubes[l[0]][1] !== uf) continue;
        if (!clubes.has(l[1])) clubes.set(l[1], new Set());
        clubes.get(l[1]).add(l[0]);
      }
      const sel = $('f-comp-clube');
      sel.innerHTML = '<option value="">Todas</option>' + dados.comps.map((c, i) => (clubes.has(i)
        ? `<option value="${esc(c)}">${esc(c)} (${clubes.get(i).size})</option>` : '')).join('');
      sel.value = [...sel.options].some((o) => o.value === atual) ? atual : '';
    }

    fetch('/dados/clubes.json').then((r) => r.json()).then((d) => {
      dados = d;
      definirEscudos(d.escudos);
      participantes = d.participantes.map((l) => new Set(l));
      doBrasileiro = Object.fromEntries(Object.entries(d.brasileiro).map(([s, l]) => [s, new Set(l)]));
      // estados: só os que têm clube com jogo em casa registrado
      const ufs = [...new Set(d.clubes.map((c) => c[1]).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
      $('f-uf-clube').insertAdjacentHTML('beforeend', ufs.map((u) => `<option value="${esc(u)}">${esc(u)}</option>`).join(''));
      const p = new URLSearchParams(location.search);
      if (p.get('uf') && ufs.includes(p.get('uf'))) $('f-uf-clube').value = p.get('uf');
      montarCompeticoes(p.get('comp') || '');
      if (p.get('q')) $('busca-clube').value = p.get('q');
      $('f-todos-jogos').checked = p.get('todos') === '1';
      const sem = p.get('sem') || (p.get('semBr') === '1' ? 'ABCD' : '');   // (semBr=1: link antigo = as quatro séries)
      document.querySelectorAll('.f-sem-serie').forEach((i) => { i.checked = sem.includes(i.value); });
      desenhar();
    }).catch(() => { /* fica a tabela renderizada no build (todas as competições) */ });

    for (const el of [$('f-comp-clube'), $('f-todos-jogos'), ...document.querySelectorAll('.f-sem-serie')]) el.addEventListener('input', () => dados && desenhar());
    $('f-uf-clube').addEventListener('input', () => { if (!dados) return; montarCompeticoes($('f-comp-clube').value); desenhar(); });
    $('busca-clube').addEventListener('input', () => dados && desenhar());
    document.querySelectorAll('th[data-ord]').forEach((th) => th.addEventListener('click', () => {
      if (!dados) return;
      const c = th.dataset.ord;
      ordem = { campo: c, dir: ordem.campo === c ? -ordem.dir : (c === 'nome' || c === 'uf' ? 1 : -1) };
      desenhar();
    }));
  </script>
</Base>
