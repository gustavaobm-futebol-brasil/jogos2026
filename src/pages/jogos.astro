---
import Base from '../layouts/Base.astro';
---
<Base titulo="Jogos" descricao="Explore todos os jogos: público, arrecadação, despesas e link para a súmula e o borderô de cada um.">
  <h1>Explorador de jogos</h1>
  <p class="lead">Filtre por clube, estádio, competição, estado ou período. Os links <b>S</b> (súmula) e <b>B</b> (borderô) abrem o documento original na federação.</p>

  <form class="filtros" id="filtros" autocomplete="off" onsubmit="return false">
    <label>Clube
      <div class="combo">
        <input type="text" id="f-clube" placeholder="ex.: Flamengo, Tombense" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sugestoes" autocomplete="off" />
        <ul id="sugestoes" role="listbox" aria-label="Clubes sugeridos" hidden></ul>
      </div>
    </label>
    <div class="papel" role="radiogroup" aria-label="Papel do clube no jogo">
      <span>O clube joga como</span>
      <div class="ops">
        <label><input type="radio" name="papel" value="" checked /> Qualquer</label>
        <label><input type="radio" name="papel" value="mandante" /> Mandante</label>
        <label><input type="radio" name="papel" value="visitante" /> Visitante</label>
      </div>
    </div>
    <label>Estádio ou cidade<input type="search" id="f-estadio" placeholder="ex.: Mineirão, Uberlândia" /></label>
    <label>Estado do jogo<select id="f-uf"><option value="">Todos</option></select></label>
    <label>Competição<select id="f-comp"><option value="">Todas</option></select></label>
    <label>De<input type="date" id="f-de" /></label>
    <label>Até<input type="date" id="f-ate" /></label>
    <label>Situação
      <select id="f-status">
        <option value="realizado">Já disputados</option>
        <option value="futuro">Ainda não disputados</option>
        <option value="">Todos</option>
      </select>
    </label>
    <label class="marcar"><input type="checkbox" id="f-bordero" /> só com borderô (valores)</label>
  </form>
  <p class="nota" id="aviso-exato" hidden></p>
  <p class="nota" id="aviso-estadio" hidden></p>
  <p class="aviso" id="aviso-limpo" hidden></p>

  <div class="barra-topo">
    <span id="contagem" class="muted" role="status">Carregando…</span>
    <button class="acao" id="limpar" type="button">Limpar filtros</button>
  </div>

  <div class="abas" role="tablist" aria-label="Formas de ver os jogos">
    <button type="button" role="tab" id="aba-lista" data-aba="lista" aria-selected="true" aria-controls="painel-lista">Lista</button>
    <button type="button" role="tab" id="aba-resumo" data-aba="resumo" aria-selected="false" aria-controls="painel-resumo" tabindex="-1">Resumo</button>
    <button type="button" role="tab" id="aba-graficos" data-aba="graficos" aria-selected="false" aria-controls="painel-graficos" tabindex="-1">Gráficos</button>
  </div>

  <div id="painel-resumo" role="tabpanel" aria-labelledby="aba-resumo" hidden></div>
  <div id="painel-graficos" role="tabpanel" aria-labelledby="aba-graficos" hidden></div>

  <div id="painel-lista" role="tabpanel" aria-labelledby="aba-lista">
  <div class="paginacao">
    <button class="acao" id="ant" type="button">← Anterior</button>
    <span id="pag" class="muted"></span>
    <button class="acao" id="prox" type="button">Próxima →</button>
  </div>

  <div class="tabela">
    <table id="tab">
      <thead>
        <tr>
          <th data-ord="data" class="desc">Data</th>
          <th>Jogo</th>
          <th>Competição</th>
          <th>Estádio</th>
          <th data-ord="pub" class="n">Público</th>
          <th data-ord="bruta" class="n">Arrecadação</th>
          <th data-ord="renda" class="n">Renda líquida</th>
          <th>Docs</th>
        </tr>
      </thead>
      <tbody id="corpo"></tbody>
    </table>
  </div>

  <p class="legenda">
    Selos de atenção: <span class="sel">A</span> a conta do borderô não fecha (pode ser desconto legítimo) ·
    <span class="sel">D</span> a data do documento difere da do calendário ·
    <span class="sel">I</span> mandante e visitante estão trocados no documento ·
    <span class="sel">F</span> documento ainda não publicado, ou indisponível na federação. Veja a <a href="/metodologia">metodologia</a>.
  </p>
  </div>

  <script>
    import { renderResumo } from '../scripts/resumo.js';
    import { renderGraficos } from '../scripts/graficos.js';

    const POR_PAGINA = 50;
    const SELOS = { A: 'A conta do borderô não fecha (pode ser desconto legítimo)', D: 'A data do documento difere da data do calendário', I: 'Mandante e visitante trocados no documento', F: 'Documento ainda não publicado ou indisponível na federação' };
    const fmtInt = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 });
    const fmtBRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const semAcento = (s) => String(s ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    let jogos = [];
    let estadios = [];         // [[texto de exibição, nome para busca]], indexada por estId
    let aba = 'lista';
    let estFiltro = -1;        // estádio escolhido no Resumo (índice em `estadios`): vale para todas as grafias do mesmo estádio
    let filtrados = [];
    let pagina = 0;
    let ordem = { campo: 'data', dir: -1 };
    // Quando se chega pelo ranking de clubes, o time vem pelo nome EXATO ("Flamengo" não pode trazer "Flamengo de Guarulhos").
    // Digitar no campo Clube volta para a busca por parte do nome.
    let nomeExato = '';        // derivado: nome canônico quando o texto do campo é o nome completo de um clube
    let forcarParcial = false; // o usuário pediu "incluir nomes parecidos" (busca por parte do nome mesmo com nome completo)
    let clubes = [];           // [{ nome, norm, n }] — n = jogos disputados
    const clubePorNorm = new Map();

    const papel = () => document.querySelector('input[name=papel]:checked').value;

    function carregar(d) {
      estadios = d.estadios || [];
      jogos = d.linhas.map((l) => {
        const o = Object.fromEntries(d.campos.map((c, i) => [c, l[i]]));
        o.bMand = semAcento(o.mandante);
        o.bVis = semAcento(o.visitante);
        o.bEst = semAcento(o.estadio);
        return o;
      });
      const ufs = [...new Set(jogos.map((j) => j.ufJogo))].filter(Boolean).sort();
      $('f-uf').insertAdjacentHTML('beforeend', ufs.map((u) => `<option>${esc(u)}</option>`).join(''));
      const comps = [...new Set(jogos.map((j) => j.comp))].filter(Boolean).sort((a, b) => a.localeCompare(b, 'pt-BR'));
      $('f-comp').insertAdjacentHTML('beforeend', comps.map((c) => `<option>${esc(c)}</option>`).join(''));
      const cont = new Map();
      for (const j of jogos) for (const nome of [j.mandante, j.visitante]) {
        if (!cont.has(nome)) cont.set(nome, 0);
        if (j.status === 'realizado') cont.set(nome, cont.get(nome) + 1);
      }
      clubes = [...cont.entries()].map(([nome, n]) => ({ nome, norm: semAcento(nome), n }));
      clubes.forEach((c) => clubePorNorm.set(c.norm, c.nome));
      lerEndereco();
      aplicar();
      mudarAba(aba, false);
    }

    /** O endereço guarda os filtros (compartilhável): ?time=Flamengo&papel=mandante&uf=RJ ... */
    function lerEndereco() {
      const p = new URLSearchParams(location.search);
      $('f-clube').value = p.get('time') || p.get('clube') || '';
      forcarParcial = p.get('parcial') === '1';
      const r = document.querySelector(`input[name=papel][value="${p.get('papel') || ''}"]`);
      if (r) r.checked = true;
      if (p.get('estadio')) $('f-estadio').value = p.get('estadio');
      if (p.get('uf')) $('f-uf').value = p.get('uf');
      if (p.get('comp')) $('f-comp').value = p.get('comp');
      if (p.get('de')) $('f-de').value = p.get('de');
      if (p.get('ate')) $('f-ate').value = p.get('ate');
      if (p.get('situacao') !== null) $('f-status').value = p.get('situacao') === 'todos' ? '' : p.get('situacao');
      if (p.get('bordero')) $('f-bordero').checked = true;
      if (['resumo', 'graficos'].includes(p.get('aba'))) aba = p.get('aba');
      if (p.get('est')) estFiltro = estadios.findIndex((e) => e[0] === p.get('est'));
    }

    function gravarEndereco() {
      const p = new URLSearchParams();
      const clube = $('f-clube').value.trim();
      if (clube) p.set(nomeExato ? 'time' : 'clube', nomeExato || clube);
      if (clube && forcarParcial) p.set('parcial', '1');
      if (papel() && clube) p.set('papel', papel());
      if ($('f-estadio').value.trim()) p.set('estadio', $('f-estadio').value.trim());
      if ($('f-uf').value) p.set('uf', $('f-uf').value);
      if ($('f-comp').value) p.set('comp', $('f-comp').value);
      if ($('f-de').value) p.set('de', $('f-de').value);
      if ($('f-ate').value) p.set('ate', $('f-ate').value);
      const st = $('f-status').value;
      if (st !== 'realizado') p.set('situacao', st || 'todos');
      if ($('f-bordero').checked) p.set('bordero', '1');
      if (estFiltro >= 0) p.set('est', estadios[estFiltro][0]);
      if (aba !== 'lista') p.set('aba', aba);
      const q = p.toString();
      history.replaceState(null, '', location.pathname + (q ? '?' + q : ''));
    }

    /** Filtro como função. `ignorar` ('uf' | 'comp') deixa aquele filtro de fora: é o que permite calcular as opções de cada lista. */
    function predicado(ignorar) {
      const clube = $('f-clube').value.trim();
      const exato = !!nomeExato;
      const t = semAcento(clube), est = semAcento($('f-estadio').value.trim()), pp = papel();
      const uf = ignorar === 'uf' ? '' : $('f-uf').value;
      const comp = ignorar === 'comp' ? '' : $('f-comp').value;
      const de = $('f-de').value, ate = $('f-ate').value, st = $('f-status').value, soB = $('f-bordero').checked;
      const casaClube = (j) => {
        const mand = exato ? j.mandante === nomeExato : j.bMand.includes(t);
        const vis = exato ? j.visitante === nomeExato : j.bVis.includes(t);
        return pp === 'mandante' ? mand : pp === 'visitante' ? vis : mand || vis;
      };
      return (j) => (!clube || casaClube(j)) && (!est || j.bEst.includes(est)) && (estFiltro < 0 || j.estId === estFiltro) && (!uf || j.ufJogo === uf) && (!comp || j.comp === comp) &&
        (!de || (j.data && j.data >= de)) && (!ate || (j.data && j.data <= ate)) && (!st || j.status === st) && (!soB || j.urlB);
    }

    /** Estado e Competição só oferecem o que existe nos jogos que passam pelos OUTROS filtros (clube, papel, estádio, período,
     *  situação e a outra lista), com a contagem de jogos. Se a seleção atual deixou de existir, ela é limpa. */
    function atualizarOpcoes(removidos) {
      let limpou = false;
      for (const [campo, id, nome] of [['ufJogo', 'f-uf', 'Estado'], ['comp', 'f-comp', 'Competição']]) {
        const ok = predicado(campo === 'ufJogo' ? 'uf' : 'comp');
        const cont = new Map();
        for (const j of jogos) if (j[campo] && ok(j)) cont.set(j[campo], (cont.get(j[campo]) || 0) + 1);
        const sel = $(id), atual = sel.value;
        sel.length = 1;                                   // mantém "Todos"/"Todas"
        for (const k of [...cont.keys()].sort((a, b) => a.localeCompare(b, 'pt-BR'))) sel.add(new Option(`${k} (${fmtInt.format(cont.get(k))})`, k));
        if (atual && cont.has(atual)) sel.value = atual;
        else if (atual) { sel.value = ''; limpou = true; removidos.push(`${nome}: ${atual}`); }
      }
      return limpou;
    }

    function aplicar() {
      const clube = $('f-clube').value.trim();
      nomeExato = !clube || forcarParcial ? '' : clubePorNorm.get(semAcento(clube)) || '';
      const removidos = [];
      for (let i = 0; i < 3 && atualizarOpcoes(removidos); i++);   // limpar uma seleção pode mudar as opções da outra lista
      filtrados = jogos.filter(predicado(''));
      const aviso = $('aviso-exato');
      const parecidos = nomeExato ? clubes.filter((c) => c.nome !== nomeExato && c.norm.includes(semAcento(nomeExato))).map((c) => c.nome) : [];
      aviso.hidden = !nomeExato && !(clube && forcarParcial);
      if (nomeExato) {
        aviso.innerHTML = `Mostrando exatamente o time <b>${esc(nomeExato)}</b>.` + (parecidos.length
          ? ` Também existem nomes parecidos: ${parecidos.slice(0, 4).map(esc).join(', ')}${parecidos.length > 4 ? '…' : ''}. <button type="button" class="acao" id="btn-parcial">Incluir nomes parecidos</button>`
          : '');
      } else if (clube && forcarParcial) {
        aviso.innerHTML = `Buscando <b>${esc(clube)}</b> em qualquer parte do nome do clube. <button type="button" class="acao" id="btn-exato">Só o time exato</button>`;
      }
      const limpo = $('aviso-limpo');
      limpo.hidden = !removidos.length;
      if (removidos.length) limpo.textContent = `Filtro removido porque não há jogos com essa combinação — ${removidos.join('; ')}.`;
      const avEst = $('aviso-estadio');
      avEst.hidden = estFiltro < 0;
      if (estFiltro >= 0) {
        avEst.replaceChildren(document.createTextNode('Mostrando só os jogos no estádio '));
        const b = document.createElement('b'); b.textContent = estadios[estFiltro][0]; avEst.append(b, document.createTextNode('. '));
        const x = document.createElement('button'); x.type = 'button'; x.className = 'acao'; x.textContent = 'Remover este filtro';
        x.addEventListener('click', () => { estFiltro = -1; aplicar(); });
        avEst.append(x);
      }
      gravarEndereco();
      ordenar();
      pagina = 0;
      desenhar();
      desenharAba();
    }

    function ordenar() {
      const { campo, dir } = ordem;
      filtrados.sort((a, b) => {
        const x = a[campo], y = b[campo];
        if (x == null && y == null) return 0;
        if (x == null) return 1;          // vazios sempre no fim
        if (y == null) return -1;
        return (x < y ? -1 : x > y ? 1 : 0) * dir;
      });
    }

    function celulaDocs(j) {
      const s = j.urlS ? `<a href="${esc(j.urlS)}" target="_blank" rel="noopener" title="Súmula na federação">S</a>` : '';
      const b = j.urlB ? `<a href="${esc(j.urlB)}" target="_blank" rel="noopener" title="Borderô na federação">B</a>` : '';
      return s || b ? s + b : '<span class="sem">—</span>';
    }

    function desenhar() {
      const total = filtrados.length;
      const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
      pagina = Math.min(pagina, paginas - 1);
      const ini = pagina * POR_PAGINA;
      $('corpo').innerHTML = filtrados.slice(ini, ini + POR_PAGINA).map((j) => {
        const data = j.data ? j.data.split('-').reverse().join('/') : '—';
        const placar = j.pm != null && j.pv != null ? `${j.pm} x ${j.pv}` : '—';
        const selos = (j.flags || '').split('').map((f) => `<span class="sel" title="${esc(SELOS[f] || '')}">${f}</span>`).join('');
        const comp = j.compUrl ? `<a href="${esc(j.compUrl)}" target="_blank" rel="noopener">${esc(j.comp)}</a>` : esc(j.comp);
        const fase = [j.fase, j.rodada && !/^\d{4}$/.test(j.rodada) ? `rodada ${j.rodada}` : ''].filter(Boolean).join(' · ');
        return `<tr>
          <td>${data}<small>${esc(j.horario || '')}</small></td>
          <td><b>${esc(j.mandante)}</b> <span class="placar">${placar}</span> <b>${esc(j.visitante)}</b>${selos ? `<small>${selos}</small>` : ''}</td>
          <td>${comp}<small>${esc(j.uf)}${fase ? ' · ' + esc(fase) : ''}</small></td>
          <td>${esc(j.estadio || '')}</td>
          <td class="n">${j.pub != null ? fmtInt.format(j.pub) : '—'}</td>
          <td class="n">${j.bruta != null ? fmtBRL.format(j.bruta) : '—'}</td>
          <td class="n">${j.renda != null ? fmtBRL.format(j.renda) : '—'}</td>
          <td class="docs">${celulaDocs(j)}</td></tr>`;
      }).join('') || '<tr><td colspan="8" class="muted">Nenhum jogo com esses filtros.</td></tr>';
      $('contagem').textContent = `${fmtInt.format(total)} jogo${total === 1 ? '' : 's'}`;
      $('pag').textContent = `página ${pagina + 1} de ${paginas}`;
      $('ant').disabled = pagina === 0;
      $('prox').disabled = pagina >= paginas - 1;
      document.querySelectorAll('th[data-ord]').forEach((th) => {
        th.classList.toggle('asc', th.dataset.ord === ordem.campo && ordem.dir === 1);
        th.classList.toggle('desc', th.dataset.ord === ordem.campo && ordem.dir === -1);
      });
    }

    ['f-estadio', 'f-uf', 'f-comp', 'f-de', 'f-ate', 'f-status', 'f-bordero'].forEach((id) => $(id).addEventListener('input', aplicar));
    $('f-clube').addEventListener('input', () => { forcarParcial = false; aplicar(); sugerir(); });
    $('aviso-exato').addEventListener('click', (e) => {
      if (e.target.id === 'btn-parcial') { forcarParcial = true; aplicar(); }
      if (e.target.id === 'btn-exato') { forcarParcial = false; aplicar(); }
    });

    // ── sugestões de clube (busca sem acento; escolher uma sugestão fixa o time exato) ──
    let ativa = -1;
    let itens = [];
    function sugerir() {
      const n = semAcento($('f-clube').value.trim());
      const ul = $('sugestoes');
      ativa = -1;
      if (!n) return fecharSugestoes();
      itens = clubes.filter((c) => c.norm.includes(n))
        .sort((a, b) => (b.norm.startsWith(n) - a.norm.startsWith(n)) || b.n - a.n || a.nome.localeCompare(b.nome, 'pt-BR')).slice(0, 8);
      if (!itens.length || (itens.length === 1 && itens[0].norm === n)) return fecharSugestoes();
      ul.innerHTML = itens.map((c, i) => `<li role="option" id="sug-${i}" data-i="${i}"><span>${esc(c.nome)}</span><small>${c.n} jogo${c.n === 1 ? '' : 's'}</small></li>`).join('');
      ul.hidden = false;
      $('f-clube').setAttribute('aria-expanded', 'true');
    }
    function fecharSugestoes() { $('sugestoes').hidden = true; $('f-clube').setAttribute('aria-expanded', 'false'); ativa = -1; }
    function escolher(i) {
      if (!itens[i]) return;
      $('f-clube').value = itens[i].nome;
      forcarParcial = false;
      fecharSugestoes();
      aplicar();
    }
    function marcar(i) {
      document.querySelectorAll('#sugestoes li').forEach((li, k) => li.setAttribute('aria-selected', k === i ? 'true' : 'false'));
      ativa = i;
      if (i >= 0) $('f-clube').setAttribute('aria-activedescendant', `sug-${i}`); else $('f-clube').removeAttribute('aria-activedescendant');
    }
    $('sugestoes').addEventListener('mousedown', (e) => { const li = e.target.closest('li'); if (li) { e.preventDefault(); escolher(Number(li.dataset.i)); } });
    $('f-clube').addEventListener('keydown', (e) => {
      if ($('sugestoes').hidden) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); marcar((ativa + 1) % itens.length); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); marcar((ativa - 1 + itens.length) % itens.length); }
      else if (e.key === 'Enter' && ativa >= 0) { e.preventDefault(); escolher(ativa); }
      else if (e.key === 'Escape') fecharSugestoes();
    });
    $('f-clube').addEventListener('blur', () => setTimeout(fecharSugestoes, 120));
    $('f-clube').addEventListener('focus', () => { if ($('f-clube').value.trim()) sugerir(); });
    document.querySelectorAll('input[name=papel]').forEach((r) => r.addEventListener('change', aplicar));
    $('ant').addEventListener('click', () => { pagina--; desenhar(); window.scrollTo({ top: 0 }); });
    $('prox').addEventListener('click', () => { pagina++; desenhar(); window.scrollTo({ top: 0 }); });
    $('limpar').addEventListener('click', () => { $('filtros').reset(); forcarParcial = false; estFiltro = -1; fecharSugestoes(); aplicar(); });
    document.querySelectorAll('th[data-ord]').forEach((th) => th.addEventListener('click', () => {
      const c = th.dataset.ord;
      ordem = { campo: c, dir: ordem.campo === c ? -ordem.dir : -1 };
      ordenar(); pagina = 0; desenhar();
    }));

    // ── abas: a lista, o resumo e os gráficos mostram os mesmos jogos filtrados ──
    const ABAS = ['lista', 'resumo', 'graficos'];
    const aoFiltrar = {
      competicao: (nome) => { $('f-comp').value = nome; aplicar(); },
      estadio: (id) => { estFiltro = id; aplicar(); },
    };
    function desenharAba() {
      if (aba === 'resumo') renderResumo($('painel-resumo'), filtrados, estadios, aoFiltrar);
      if (aba === 'graficos') renderGraficos($('painel-graficos'), filtrados);
    }
    function mudarAba(nova, gravar = true) {
      aba = nova;
      ABAS.forEach((a) => {
        const sel = a === aba;
        $(`aba-${a}`).setAttribute('aria-selected', String(sel));
        $(`aba-${a}`).tabIndex = sel ? 0 : -1;
        $(`painel-${a}`).hidden = !sel;
      });
      desenharAba();
      if (gravar) gravarEndereco();
    }
    document.querySelectorAll('[role=tab]').forEach((b) => {
      b.addEventListener('click', () => mudarAba(b.dataset.aba));
      b.addEventListener('keydown', (e) => {
        const i = ABAS.indexOf(aba);
        const j = e.key === 'ArrowRight' ? (i + 1) % 3 : e.key === 'ArrowLeft' ? (i + 2) % 3 : e.key === 'Home' ? 0 : e.key === 'End' ? 2 : -1;
        if (j < 0) return;
        e.preventDefault();
        mudarAba(ABAS[j]);
        $(`aba-${ABAS[j]}`).focus();
      });
    });
    let tamanhoAnterior = window.innerWidth;
    let adiar = 0;
    window.addEventListener('resize', () => {   // gráficos em SVG têm largura fixa: redesenha ao mudar o tamanho da janela
      clearTimeout(adiar);
      adiar = setTimeout(() => { if (aba === 'graficos' && window.innerWidth !== tamanhoAnterior) desenharAba(); tamanhoAnterior = window.innerWidth; }, 200);
    });

    fetch('/dados/jogos.json').then((r) => r.json()).then(carregar).catch(() => {
      $('contagem').textContent = 'Não foi possível carregar os dados. Recarregue a página.';
    });
  </script>
</Base>
