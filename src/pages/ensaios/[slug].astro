---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  const arquivos = import.meta.glob('../../ensaios/*.md', { eager: true });
  return Object.entries(arquivos)
    .map(([caminho, m]) => ({ slug: caminho.split('/').pop().replace(/\.md$/, ''), m }))
    .filter(({ m }) => !m.frontmatter.rascunho)
    .map(({ slug, m }) => ({ params: { slug }, props: { fm: m.frontmatter, Conteudo: m.Content } }));
}

const { fm, Conteudo } = Astro.props;
const fmt = (d) => String(d).slice(0, 10).split('-').reverse().join('/');
---
<Base titulo={fm.titulo} descricao={fm.resumo}>
  <p class="small"><a href="/ensaios">← Ensaios</a></p>
  <h1>{fm.titulo}</h1>
  <p class="muted small">{fmt(fm.data)}</p>
  <article class="prosa"><Conteudo /></article>
</Base>
